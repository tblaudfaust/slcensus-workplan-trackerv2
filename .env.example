# Copy this file to .env and fill in real values for your environment.
# .env is git-ignored -- never commit real secrets or credentials.

# --- Core -------------------------------------------------------------
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=
TIME_ZONE=Africa/Freetown

# --- Database -----------------------------------------------------------
# Leave unset to use a local SQLite database (db.sqlite3) with zero setup.
# For PostgreSQL:
# DATABASE_URL=postgres://census_user:password@localhost:5432/census_tracker

# --- Email (used for task/deadline/overdue notifications) --------------
# Leave EMAIL_BACKEND unset in development to print emails to the console
# instead of sending them. For real SMTP delivery (e.g. Gmail, Office365,
# a government mail relay):
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.org
EMAIL_PORT=587
EMAIL_HOST_USER=notifications@example.org
EMAIL_HOST_PASSWORD=change-me
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=Census Workplan Tracker <notifications@example.org>

# --- Application ----------------------------------------------------------
SITE_NAME=Census Project Workplan Tracker
SITE_URL=http://localhost:8000

# In-process scheduler for daily deadline checks + weekly digest emails.
# Set to False if you run manage.py check_deadlines / send_weekly_digest
# via an external cron/Task Scheduler instead (recommended if you run more
# than one app server process).
SCHEDULER_ENABLED=True

# Default reminder windows (days before an activity's end date). Editable
# afterwards from the in-app Notification Settings page.
REMINDER_DAYS=1,3,7,14
# Number of overdue activities in one workstream before an alert email
# is sent to the project owner.
WORKSTREAM_OVERDUE_THRESHOLD=3

# --- Production hardening (only read when DEBUG=False) --------------------
# Enable once the app is served over HTTPS (directly or behind a
# TLS-terminating reverse proxy); leave False if you're not there yet.
# SECURE_SSL_REDIRECT=True
# SESSION_COOKIE_SECURE=True
# CSRF_COOKIE_SECURE=True
# SECURE_HSTS_SECONDS=31536000
